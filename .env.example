# Copy this file to .env and fill in your own keys. Never commit .env itself.

# API Keys for different providers
NVIDIA_API_KEY=your_nvidia_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default Provider Configuration
DEFAULT_PROVIDER=nvidia
DEFAULT_MODEL=openai/gpt-oss-120b

# LLM Configuration
TEMPERATURE=0.5
MAX_TOKENS=8192
TIMEOUT=600
MAX_RETRIES=3

# Multi-Judge Configuration
ENABLE_MULTI_JUDGE=true
NUM_JUDGES=3
JUDGE_MODELS=openai/gpt-oss-120b,meta/llama-3.3-70b-instruct,qwen/qwen3.5-122b-a10b

# Evaluation Settings
MAX_ITERATIONS=3
MIN_CRS_THRESHOLD=0.6

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
